{
  "description": "Keeps this repo's handoff note current. At session start, and after /clear or a compaction, Claude gets the note. Before a compaction, a short snapshot of the repo's git state is saved. After a commit, a PR merge or a subagent's result, the commit or merge is logged and Claude is reminded to update the note; a commit made by a command that then failed is logged too. Before each commit command, the folder it starts in is noted, so commits made in another folder are logged correctly. In repos where you haven't run /trailmark:memory-setup, every hook does nothing. Each hook goes through Trailmark's launcher (scripts/trailmark.js). The launcher only reads, running git to look up commits and status; the part that writes runs under Node's permission model, so it can write only in the repo's memory folder and can't start other programs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "precompact"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "commit-start"
            ],
            "if": "Bash(git commit *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "commit-start"
            ],
            "if": "Bash(git -C *)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "commit-start"
            ],
            "if": "PowerShell(git commit *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "commit-start"
            ],
            "if": "PowerShell(git -C *)",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "Bash(git commit *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "Bash(git -C *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "pr-merge"
            ],
            "if": "Bash(gh pr merge *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "PowerShell(git commit *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "PowerShell(git -C *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "pr-merge"
            ],
            "if": "PowerShell(gh pr merge *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "subagent"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "Bash(git commit *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "Bash(git -C *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "PowerShell(git commit *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trailmark.js",
              "--hook",
              "milestone",
              "commit"
            ],
            "if": "PowerShell(git -C *)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
